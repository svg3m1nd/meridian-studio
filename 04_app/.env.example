# Constrained, non-BYPASSRLS runtime role. Use Supavisor transaction mode on Vercel.
DATABASE_URL="postgresql://meridian_runtime:replace-me@localhost:5432/meridian_studio"
# Privileged migration role. Keep this local/CI-only and never add it to Vercel runtime variables.
DIRECT_URL="postgresql://meridian_migrate:replace-me@localhost:5432/meridian_studio"
APP_BASE_URL="http://localhost:3000"
LOG_LEVEL="info"
AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
